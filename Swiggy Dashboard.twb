              <bucket>&quot;10 Downing Street&quot;</bucket>
              <bucket>&quot;24 Seven&quot;</bucket>
              <bucket>&quot;24/7 - The Lalit Ashok Bangalore&quot;</bucket>
              <bucket>&quot;99@Biryani&quot;</bucket>
              <bucket>&quot;1131 Bar+Kitchen&quot;</bucket>
              <bucket>&quot;A 1 Ice Creams&quot;</bucket>
              <bucket>&quot;A Bowl Affair&quot;</bucket>
