    <worksheet name='Bottom 10 Restaurants Ratings'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='Tahoma' fontsize='10'>Bottom 10 Restaurants Ratings</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (swiggy dataset)' name='federated.1lmq5o20wco7pl1brw4vy05lhywx' />
          </datasources>
          <datasource-dependencies datasource='federated.1lmq5o20wco7pl1brw4vy05lhywx'>
            <column datatype='real' name='[Avg ratings]' role='measure' type='quantitative' />
            <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='string' name='[Restaurant]' role='dimension' type='nominal' />
            <column-instance column='[City]' derivation='None' name='[none:City:nk]' pivot='key' type='nominal' />
            <column-instance column='[Restaurant]' derivation='None' name='[none:Restaurant:nk]' pivot='key' type='nominal' />
            <column-instance column='[Avg ratings]' derivation='Sum' name='[sum:Avg ratings:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1lmq5o20wco7pl1brw4vy05lhywx].[none:Restaurant:nk]'>
            <groupfilter count='10' end='bottom' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='SUM([Avg ratings])' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:Restaurant:nk]' user:ui-manual-selection='true' user:ui-manual-selection-all-when-empty='true' user:ui-manual-selection-is-empty='true' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
          </filter>
          <manual-sort column='[federated.1lmq5o20wco7pl1brw4vy05lhywx].[none:Restaurant:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;1By2&quot;</bucket>
